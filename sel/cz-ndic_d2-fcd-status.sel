  <d2Types>
    <D2Enumeration>
      <name>TrafficStatusEnum</name>
      <definition>List of terms used to describe traffic conditions.</definition>
      <id>EAID_1D90B47B_6E67_4f0f_9E92_611FC95F2326</id>
      <isGenerated>true</isGenerated>
      <package>
        <name>Enumerations</name>
        <ID>EAPK_02A710FD_6CB6_4ef2_8910_9B80D20E536B</ID>
        <generate>false</generate>
        <definition>A collection of enumerations that are used only in the RoadTrafficData package of the DATEX II model.</definition>
        <NamespaceName>RoadTrafficData</NamespaceName>
      </package>
      <NamespaceName>RoadTrafficData</NamespaceName>
      <d2Litteral>
        <D2Litteral>
          <name>stationary</name>
          <definition>Traffic is stationary, or very near stationary, at the specified location (i.e. average speed is less than 10% of its free-flow level).</definition>
          <order>0</order>
          <generate>true</generate>
          <ID>EAID_F5BCC88A_0D6E_4033_9AA0_DA4E043AFFC9</ID>
        </D2Litteral>
        <D2Litteral>
          <name>queuing</name>
          <definition>Traffic is queuing at the specified location, although there is still some traffic movement (i.e. average speed is between 10% and 25% of its free-flow level).</definition>
          <order>1</order>
          <generate>true</generate>
          <ID>EAID_08FD28FE_58BE_418f_A4C8_43748A93BCF8</ID>
        </D2Litteral>
        <D2Litteral>
          <name>slow</name>
          <definition>Traffic is slow moving at the specified location, but not yet forming queues (i.e. average speed is between 25% and 75% of its free-flow level).</definition>
          <order>2</order>
          <generate>true</generate>
          <ID>EAID_F645F886_C2C4_4b23_809B_841C6E60AB91</ID>
        </D2Litteral>
        <D2Litteral>
          <name>heavy</name>
          <definition>Traffic in the specified direction is heavier than usual making driving conditions more difficult than normal.</definition>
          <order>3</order>
          <generate>false</generate>
          <ID>EAID_80D34E89_FD41_4e20_A8BF_E1C2CE89E1A5</ID>
        </D2Litteral>
        <D2Litteral>
          <name>unspecifiedAbnormal</name>
          <definition>There are abnormal traffic conditions of an unspecified nature at the specified location.</definition>
          <order>4</order>
          <generate>false</generate>
          <ID>EAID_0B07A625_C169_46d2_9983_769C09CAEF0A</ID>
        </D2Litteral>
        <D2Litteral>
          <name>freeFlow</name>
          <definition>Traffic at the specified location is free-flowing.</definition>
          <order>5</order>
          <generate>true</generate>
          <ID>EAID_1D165098_6280_4839_ACB9_845AA276612C</ID>
        </D2Litteral>
        <D2Litteral>
          <name>unknown</name>
          <definition>Traffic conditions are unknown.</definition>
          <order>6</order>
          <generate>true</generate>
          <ID>EAID_8ADE3FF4_F012_492b_8F13_C70B40B49567</ID>
        </D2Litteral>
        <D2Litteral>
          <name>other</name>
          <definition>Other than as defined in this enumeration.</definition>
          <order>7</order>
          <generate>false</generate>
          <ID>EAID_D0F4E279_D7FB_4d95_82EC_04860F8F7FB3</ID>
        </D2Litteral>
      </d2Litteral>
      <isExtension>false</isExtension>
